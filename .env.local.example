# Fuente de datos del catálogo: "mock" (por defecto) o "supabase".
# Dejalo en "mock" mientras se valida la experiencia de Catálogo / Ficha de
# producto; pasalo a "supabase" cuando las tablas de supabase/schema.sql
# estén creadas y cargadas con datos.
DATA_SOURCE=mock

# Credenciales del proyecto de Supabase (Project Settings > API).
# Requeridas para DATA_SOURCE=supabase Y para Registro/Login/Favoritos
# (Supabase Auth usa las mismas credenciales).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: forzar la URL pública del sitio (usada en el link de
# confirmación de email). Si no se define, se infiere del request —
# solo hace falta si eso da problemas en algún entorno particular.
# NEXT_PUBLIC_SITE_URL=https://habitando.com.ar

# --- Sección B2B para estudios (/para-estudios, /admin/estudios) ---

# Clave de servicio de Supabase (Project Settings > API > service_role /
# "secret" en el sistema nuevo de keys). Permite invitar usuarios y
# saltarse RLS: SOLO se usa en Server Actions, nunca en el cliente.
# ⚠️ NUNCA le pongas el prefijo NEXT_PUBLIC_ ni la subas a ningún lado.
SUPABASE_SERVICE_ROLE_KEY=

# Emails (separados por coma) con acceso al panel de admin en
# /admin/estudios. Usá el email con el que te registrás en /registro.
ADMIN_EMAILS=
